# ALFA LUBES - Variables de entorno
# Copia este archivo a .env y completa los valores antes de ejecutar en producción.

ALFA_LUBES_SECRET_KEY=
ALFA_LUBES_DB=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_PUBLISHABLE_KEY=
# OBLIGATORIAS EN VERCEL para que los usuarios registrados puedan ingresar:
# SUPABASE_SERVICE_ROLE_KEY = Supabase -> Settings -> API -> service_role (SECRETA, nunca en git)
# ALFA_LUBES_SECRET_KEY = una frase larga fija e inventada por ti; sin ella cada
# instancia firma las sesiones con una llave distinta y el login rebota.
SUPABASE_SERVICE_ROLE_KEY=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
MEAI_API_KEY=
MEAI_BASE_URL=
MEAI_MODEL=
FLASK_DEBUG=
PORT=
BRAND_NAME=
CONTACT_EMAIL=
SALES_EMAIL=
SUPPORT_EMAIL=
ADMIN_EMAIL=
SITE_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=