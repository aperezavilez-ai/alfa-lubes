# ALFA LUBES - Variables de entorno
# Copia este archivo a .env y completa los valores necesarios.

# Flask
ALFA_LUBES_SECRET_KEY=
FLASK_DEBUG=0
PORT=5000

# Base de datos local (SQLite)
ALFA_LUBES_DB=

# Supabase (PostgreSQL / REST)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# IA (proveedor OpenAI-compatible)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Identidad y contacto
BRAND_NAME=ALFA LUBES
SITE_URL=https://alfalubes.com
CONTACT_EMAIL=contacto@alfalubes.com
SALES_EMAIL=ventas@alfalubes.com
SUPPORT_EMAIL=soporte@alfalubes.com
ADMIN_EMAIL=admin@alfalubes.com

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ventas@alfalubes.com
SMTP_USE_TLS=1

# Redes sociales / WhatsApp
WHATSAPP_NUMBER=
WHATSAPP_URL=
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=
SOCIAL_YOUTUBE=

# SEO / Analytics
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
